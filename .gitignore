.abacus/
.beads/
tags
*.swp
fonts/berkeley-mono/*.ttf
machines/local-profile.nix
# Belt-and-braces: never let a git-crypt-style key file get snapshotted into history
secret-key
# Machine-local Claude Code permission allowlist — churns per-machine, not shared
.claude/settings.local.json

# Secrets: fail closed. git-crypt was decommissioned (its .gitattributes filter was inert),
# so nothing here is transparently encrypted. Only sops-encrypted *.yaml is safe to commit;
# everything else under secrets/ (raw .env, keys, etc.) must stay untracked.
secrets/*
!secrets/*.yaml
